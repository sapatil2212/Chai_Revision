# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"



# ===============================
# DATABASE CONFIGURATION
# ===============================
# Real values go in .env (gitignored). Never commit credentials here.
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"

DB_HOST="your-db-host"
DB_PORT="3306"
DB_USER="your-db-user"
DB_PASSWORD="your-db-password"
DB_NAME="chairevision"

# ===============================
# SUPERADMIN AUTH
# ===============================
ADMIN_USER="admin@example.com"
ADMIN_PASS="change-me"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET="long-random-string"

# ===============================
# FILE STORAGE
# ===============================
# Absolute path OUTSIDE the build folder (output: 'standalone' runs from .next/standalone,
# which is wiped on every build). The Node process must have write access to it.
STORAGE_ROOT="/var/www/storage/chairevision"
STORAGE_DIR_IMAGES="images"
STORAGE_DIR_PDFS="pdfs"
STORAGE_DIR_TEMP="temp"
STORAGE_DIR_AVATARS="avatars"
STORAGE_DIR_LOGOS="logos"
STORAGE_DIR_EXPORTS="exports"
STORAGE_DIR_EMAIL_ASSETS="email-assets"
STORAGE_DIR_PREVIEWS="previews"
PREVIEW_PAGES="2"
MAX_IMAGE_UPLOAD_MB="5"
MAX_PDF_UPLOAD_MB="100"
TEMP_FILE_TTL_HOURS="24"

# ===============================
# QUIZ ENGINE
# ===============================
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
QUIZ_TOKEN_SECRET="long-random-string"
QUIZ_GRACE_SECONDS="60"

# ===============================
# AI (admin document import)
# ===============================
# Used to auto-fill quizzes and questions from uploaded documents
GEMINI_MODEL="gemini-3.8-flash"
MAX_AI_DOC_MB="20"
# ===============================
# PAYMENTS (Razorpay)
# ===============================
# Dashboard -> Account & Settings -> API Keys.
# Use rzp_test_* keys while developing; rzp_live_* keys charge real money.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# A secret YOU choose, then paste into Dashboard -> Settings -> Webhooks.
# It must match exactly or every webhook will be rejected.
RAZORPAY_WEBHOOK_SECRET="long-random-string"
#
# Webhook endpoint to register in the Razorpay dashboard:
#   https://<your-domain>/api/payments/webhook
# Active events: payment.captured, payment.failed, order.paid
#
# Notes:
#  - KEY_SECRET and WEBHOOK_SECRET must never reach the browser. Only the key id
#    is sent to the client, and it is returned by /api/payments/checkout rather
#    than exposed as a NEXT_PUBLIC_* variable.
#  - A VITE_RAZORPAY_KEY_ID variable has no effect here; this is a Next.js app.
