{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean",
    "db:check": "node --env-file=.env scripts/db-check.mjs",
    "db:generate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=.env node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "tsx --env-file=.env db/seed.ts",
    "db:verify": "tsx --env-file=.env scripts/db-verify.ts",
    "test:admin": "node --env-file=.env scripts/e2e-admin.mjs",
    "test:quiz": "node --env-file=.env scripts/e2e-quiz.mjs",
    "test:ai": "node --env-file=.env scripts/e2e-ai-quiz.mjs",
